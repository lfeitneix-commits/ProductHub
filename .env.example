# Copiar a .env (no se sube al repo) y completar.

# Carga de Firestore (npm run seed): ruta al JSON de la cuenta de servicio de Firebase.
# Firebase console › Configuración del proyecto › Cuentas de servicio › Generar nueva clave privada.
# Guardalo FUERA del repo.
GOOGLE_APPLICATION_CREDENTIALS=/ruta/fuera/del/repo/cuenta-de-servicio.json

# Editores del Hub (Marketing y responsables), separados por coma.
EDITORES=nombre@neix.com.ar,otra@neix.com.ar
